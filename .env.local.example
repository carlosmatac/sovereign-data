# ============================================
# Sovereign Data — Environment Variables
# ============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection strings for migration tooling and read-only diagnostic
# scripts (e.g. scripts/audit/database-baseline.ts). NOT used by the Next.js
# app at runtime — runtime code goes through Supabase clients above.
# Get both from: Supabase Dashboard → Project Settings → Database → Connection string.
# Diagnostic scripts try DATABASE_URL_DIRECT first, then DATABASE_URL_POOLER.
DATABASE_URL_DIRECT=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL_POOLER=postgresql://postgres.your-project-ref:your-db-password@aws-X-your-region.pooler.supabase.com:5432/postgres

# --- AssemblyAI ---
ASSEMBLYAI_API_KEY=your-assemblyai-api-key

# --- OpenAI ---
OPENAI_API_KEY=your-openai-api-key

# --- Tavily (Web Search for Agentic RAG) ---
# Optional — if not set, the Copilot web search tool is disabled gracefully
TAVILY_API_KEY=your-tavily-api-key

# --- Webhooks ---
# Base URL of this app (used to construct webhook callback URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret to verify webhook signatures from AssemblyAI
WEBHOOK_SECRET=generate-a-random-secret-here
